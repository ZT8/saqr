# Copy to .env and adjust. All values are optional for local demo.
PORT=3000
# Authority dashboard account (created on first start). CHANGE before any real deployment.
ADMIN_USER=admin
ADMIN_PASS=saqr-demo-2026
# Secret for hashing reporter fingerprints. Leave empty to generate a random one each start (max privacy).
HASH_SECRET=
# Load demo data on first start when the database is empty (true/false)
DEMO_DATA=true
# A pending indicator appears (masked) in the public registry after this many independent reports
PUBLIC_THRESHOLD=3
SESSION_HOURS=8
DB_PATH=./data/saqr.db
